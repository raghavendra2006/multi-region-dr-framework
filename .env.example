# =============================================================
# Multi-Region DR Framework — Environment Configuration
# Copy this file to .env and adjust values as needed.
# Usage: cp .env.example .env
# =============================================================

# --- Region Configuration ---
PRIMARY_REGION=us-east-1
DR_REGION=us-west-2

# --- S3 Bucket Names ---
PRIMARY_BUCKET_NAME=my-app-backups-primary
DR_BUCKET_NAME=my-app-backups-dr

# --- AWS Credentials ---
# For LocalStack testing, use "test" as dummy credentials.
# For production, use IAM roles or configure via `aws configure`.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- Database Paths (host-relative for scripts) ---
PRIMARY_DB_PATH=./data/primary/application.db
DR_DB_PATH=./data/dr/application.db